{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "signalreach-landing",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-05-09",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "signalreach_landing",
			"database_name": "signalreach_landing",
			"database_id": "f96a122f-008e-487d-8b84-48b8530cdf07",
			"remote": true
		}
	],
	"vars": {
		"TURNSTILE_SITE_KEY": "0x4AAAAAADL0rPeKhtLCT_3X"
	},
	"observability": {
		"enabled": true
	}
}